{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dewey": {
      "type": "local",
      "command": [
        "dewey",
        "serve",
        "--vault",
        "."
      ],
      "enabled": true
    },
    "replicator": {
      "type": "local",
      "command": [
        "replicator",
        "serve"
      ],
      "enabled": true
    },
    "fieldkit-search": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/v0/groups/fieldkit-search/mcp"
    }
  }
}
